---
const pathname = Astro.url.pathname;
const isEn = pathname.includes('/ASIR-Redes/en/') || pathname.startsWith('/en/');

const esItems = [
  { 
    label: '1 · Comunicación y red de datos', 
    href: '/ASIR-Redes/es/u01/u0101comunicacion_y_red_de_datos_es/' 
  },
  { 
    label: '2 · Componentes y primera representación', 
    href: '/ASIR-Redes/es/u01/u0102componentes_y_primera_representacion_es/' 
  },
  { 
    label: '3 · Tipos de red y arquitecturas de servicio', 
    href: '/ASIR-Redes/es/u01/u0103tipos_de_red_y_arquitecturas_de_servicio_es/' 
  },
];

const enItems = [
  { 
    label: '1 · Communication and data networks', 
    href: '/ASIR-Redes/en/u01/u0101communication_and_data_networks_en/' 
  },
  { 
    label: '2 · Components and first network representation', 
    href: '/ASIR-Redes/en/u01/u0102components_and_first_network_representation_en/' 
  },
  { 
    label: '3 · Network types and service architectures', 
    href: '/ASIR-Redes/en/u01/u0103network_types_and_service_architectures_en/' 
  },
];

const items = isEn ? enItems : esItems;
const title = isEn ? 'U1 · Network Fundamentals' : 'U1 · Fundamentos de redes';
---

<nav class="custom-sidebar">
  <div class="group-title">{title}</div>
  <ul class="link-list">
    {items.map((item) => {
      const isActive = pathname.toLowerCase() === item.href.toLowerCase();
      return (
        <li>
          <a href={item.href} class={isActive ? 'active' : ''}>
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .custom-sidebar {
    padding: 1rem 0;
  }
  .group-title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    padding: 0.5rem 1rem;
    margin-bottom: 0.25rem;
  }
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .link-list li a {
    display: block;
    padding: 0.4rem 1rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    border-inline-start: 2px solid transparent;
  }
  .link-list li a:hover {
    color: var(--sl-color-white);
  }
  .link-list li a.active {
    color: var(--sl-color-accent-high);
    font-weight: 600;
    background-color: var(--sl-color-accent-low);
    border-inline-start: 2px solid var(--sl-color-accent-high);
  }
</style>